<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>B.K. Motors | Dehradun</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
font-family:Arial,Helvetica,sans-serif;
background:#070707;
color:#fff;
}
a{text-decoration:none;color:inherit}

header{
position:fixed;
top:0;
left:0;
width:100%;
z-index:999;
height:76px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 6%;
background:rgba(0,0,0,.72);
backdrop-filter:blur(18px);
border-bottom:1px solid rgba(255,255,255,.1);
}

.logo{
font-size:25px;
font-weight:900;
letter-spacing:1px;
}
.logo span{color:#e21b23}

nav{
display:flex;
gap:30px;
}
nav a{
font-size:13px;
font-weight:bold;
letter-spacing:1px;
transition:.3s;
}
nav a:hover{color:#e21b23}

.hero{
height:100vh;
min-height:650px;
position:relative;
display:flex;
align-items:center;
overflow:hidden;
}

.hero video{
position:absolute;
inset:0;
width:100%;
height:100%;
object-fit:cover;
z-index:-2;
}

.hero:after{
content:"";
position:absolute;
inset:0;
z-index:-1;
background:
linear-gradient(90deg,rgba(0,0,0,.94),rgba(0,0,0,.55),rgba(0,0,0,.25)),
linear-gradient(0deg,#070707,transparent 35%);
}

.hero-content{
width:88%;
max-width:1250px;
margin:auto;
padding-top:70px;
}

.tag{
display:inline-block;
border:1px solid rgba(255,255,255,.3);
background:rgba(255,255,255,.07);
padding:10px 17px;
border-radius:30px;
font-size:11px;
letter-spacing:2px;
}

.hero h1{
font-size:clamp(48px,8vw,92px);
line-height:.93;
margin:24px 0;
font-weight:900;
}
.hero h1 span{color:#e21b23}

.hero p{
max-width:600px;
color:#c8c8c8;
font-size:18px;
line-height:1.7;
}

.buttons{
display:flex;
gap:14px;
margin-top:32px;
flex-wrap:wrap;
}

.btn{
display:inline-block;
padding:16px 27px;
border-radius:4px;
font-size:13px;
font-weight:bold;
letter-spacing:.7px;
transition:.3s;
}

.red{
background:#e21b23;
}
.red:hover{
background:#ff3038;
transform:translateY(-3px);
}

.white{
border:1px solid #777;
background:rgba(0,0,0,.3);
}
.white:hover{
border-color:#fff;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
background:#0d0d0d;
border-top:1px solid #252525;
border-bottom:1px solid #252525;
}

.stat{
text-align:center;
padding:35px 10px;
border-right:1px solid #252525;
}
.stat:last-child{border:0}
.stat strong{
display:block;
font-size:34px;
}
.stat span{
display:block;
margin-top:7px;
color:#888;
font-size:13px;
}

section{
padding:100px 6%;
}

.section-head{
margin-bottom:45px;
}
.section-head h2{
font-size:43px;
margin-bottom:10px;
}
.section-head p{
color:#888;
}

.inventory{
background:#0b0b0b;
}

.cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:22px;
}

.card{
background:#121212;
border:1px solid #282828;
border-radius:10px;
overflow:hidden;
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
border-color:#e21b23;
box-shadow:0 25px 60px rgba(0,0,0,.5);
}

.card img{
width:100%;
height:250px;
object-fit:cover;
display:block;
}

.card-body{
padding:22px;
}

.type{
font-size:11px;
color:#e21b23;
font-weight:bold;
letter-spacing:2px;
}

.card h3{
font-size:23px;
margin:10px 0;
}

.info{
color:#888;
font-size:14px;
line-height:1.7;
}

.price{
font-size:22px;
font-weight:bold;
margin:18px 0;
}

.enquire{
display:block;
text-align:center;
padding:13
